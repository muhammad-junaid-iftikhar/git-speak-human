{
  "name": "git-speak-human",
  "version": "0.1.0",
  "description": "gitbuddy: git for humans. Plain-English commands, nothing ever lost, fun to use, and friendly to AI agents.",
  "type": "module",
  "bin": {
    "gitbuddy": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test --timeout 60000",
    "build": "bun build src/cli.ts --compile --outfile dist/gitbuddy"
  },
  "keywords": [
    "git",
    "cli",
    "beginner",
    "workspaces",
    "undo",
    "mcp",
    "ai-agents",
    "human"
  ],
  "author": "Muhammad Junaid Iftikhar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammad-junaid-iftikhar/git-speak-human.git"
  },
  "homepage": "https://github.com/muhammad-junaid-iftikhar/git-speak-human#readme",
  "bugs": "https://github.com/muhammad-junaid-iftikhar/git-speak-human/issues",
  "devDependencies": {
    "@types/bun": "latest"
  }
}
