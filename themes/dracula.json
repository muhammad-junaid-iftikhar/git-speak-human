{
  "name": "dracula",
  "title": "Dracula",
  "author": "gitbuddy",
  "description": "The famous dark purple theme",
  "terminal": {
    "background": "#282a36",
    "foreground": "#f8f8f2",
    "cursor": "#f8f8f2",
    "selection": "#44475a",
    "bold": "#ffffff",
    "ansi": [
      "#21222c",
      "#ff5555",
      "#50fa7b",
      "#f1fa8c",
      "#bd93f9",
      "#ff79c6",
      "#8be9fd",
      "#f8f8f2",
      "#6272a4",
      "#ff6e6e",
      "#69ff94",
      "#ffffa5",
      "#d6acff",
      "#ff92df",
      "#a4ffff",
      "#ffffff"
    ],
    "font": {
      "name": "JetBrainsMonoNF-Regular",
      "size": 13,
      "fallback": "SFMono-Regular",
      "brew": "font-jetbrains-mono-nerd-font"
    },
    "opacity": 1.0,
    "blur": 0,
    "cursorShape": "block",
    "blink": false,
    "spacing": {
      "width": 1,
      "height": 1.05
    },
    "columns": 120,
    "rows": 34
  },
  "prompt": {
    "starship": "auto"
  },
  "shell": {
    "autosuggestColor": "#6272a4",
    "syntax": {
      "command": "fg=#69ff94",
      "builtin": "fg=#69ff94",
      "alias": "fg=#a4ffff",
      "unknown-token": "fg=#ff6e6e,bold",
      "path": "fg=#d6acff,underline",
      "single-quoted-argument": "fg=#ffffa5",
      "double-quoted-argument": "fg=#ffffa5",
      "comment": "fg=#6272a4"
    },
    "history": {
      "size": 100000,
      "share": true,
      "ignoreDups": true
    },
    "aliases": {
      "ls": "eza --icons --group-directories-first",
      "ll": "eza -la --icons --group-directories-first",
      "lt": "eza --tree --icons --level=2"
    }
  },
  "tools": [
    "starship",
    "zsh-autosuggestions",
    "zsh-syntax-highlighting",
    "eza"
  ],
  "gitbuddy": {
    "accent": "#d6acff",
    "ok": "#69ff94",
    "warn": "#ffffa5",
    "err": "#ff6e6e",
    "dim": "#6272a4",
    "mascot": "🧛"
  }
}
